{
  "expo": {
    "name": "To Taste",
    "slug": "to-taste",
    "scheme": "totaste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "description": "An emoji-first recipe book for the recipes you love.",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.pinch.cookbook"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      ["expo-image-picker", {
        "photosPermission": "Choose a photo for your To Taste profile.",
        "cameraPermission": false,
        "microphonePermission": false
      }]
    ]
  }
}
